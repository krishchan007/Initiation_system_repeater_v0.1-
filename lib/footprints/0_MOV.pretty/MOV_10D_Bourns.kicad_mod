(footprint "MOV_10D_Bourns"
  (version 20211014)
  (generator pcbnew)

  (descr "Metal Oxide Varistor, Bourns MOV-10D series, 10mm disc, 5.0mm lead pitch")
  (tags "MOV Varistor Bourns 10mm Radial")

  (attr through_hole)

  (fp_text reference "RV?"
    (at 2.5 -6.0)
    (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  (fp_text value "MOV-10D561K"
    (at 2.5 6.0)
    (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  (fp_circle
    (center 2.5 0)
    (end 7.5 0)
    (layer "F.SilkS")
    (width 0.12)
  )

  (fp_rect
    (start -3.75 -6.25)
    (end 8.75 6.25)
    (layer "F.CrtYd")
    (width 0.05)
  )

  (fp_circle
    (center 2.5 0)
    (end 7.5 0)
    (layer "F.Fab")
    (width 0.1)
  )

  (pad "1" thru_hole circle
    (at 0 0)
    (size 2.2 2.2)
    (drill 1.2)
    (layers "*.Cu" "*.Mask")
  )

  (pad "2" thru_hole circle
    (at 5.0 0)
    (size 2.2 2.2)
    (drill 1.2)
    (layers "*.Cu" "*.Mask")
  )
)
